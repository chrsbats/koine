include LICENSE
include README.md
include PARSING.md
include TRANSPILING.md
include SPEC.md
include koine.nimble
include MANIFEST.in
graft python
graft native
graft nim
prune nim/koine
graft tests
graft tools
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.a
global-exclude *.dll
global-exclude *.lib
global-exclude *.exp
global-exclude *.dll.a
global-exclude *.dylib
prune build
prune dist
