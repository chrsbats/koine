set(CMAKE_SYSTEM_NAME Linux)
if(NOT DEFINED ENV{KOINE_SDK_ROOT})
    message(FATAL_ERROR "Set KOINE_SDK_ROOT to the SDK created by native/tools/prepare_linux_sdk.py")
endif()
set(CMAKE_SYSROOT "$ENV{KOINE_SDK_ROOT}/sysroot")
set(toolset "${CMAKE_SYSROOT}/opt/rh/gcc-toolset-15/root/usr")
set(CMAKE_C_COMPILER "${toolset}/bin/gcc")
set(CMAKE_CXX_COMPILER "${toolset}/bin/g++")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
